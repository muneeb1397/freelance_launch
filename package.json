{
  "name": "freelancelaunch",
  "version": "1.0.0",
  "description": "FreelanceLaunch - All-in-one AI platform for freelancers (Pak Angels Hackathon)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start:server": "npm run dev --workspace=server",
    "start:client": "npm run dev --workspace=client",
    "install:all": "npm install --workspace=server && npm install --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
